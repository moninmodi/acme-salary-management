# Copy to .env for local development. Never commit real secrets.
APP_NAME=ACME Salary Management

# Database (docker compose overrides SALARY_DB_HOST to the mariadb service for the api container)
SALARY_DB_HOST=127.0.0.1
SALARY_DB_PORT=3306
SALARY_DB_USER=salary_app
SALARY_DB_PASSWORD=salary_local
SALARY_DB_NAME=acme_salary
SALARY_TEST_DB_NAME=acme_salary_test
MARIADB_ROOT_PASSWORD=local-root-password
CORS_ORIGINS=http://localhost:5173

# Optional AI feature: leave empty to disable "Ask about compensation"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Docker Compose (optional)
# WEB_PORT=8080          # host port for the UI
# MARIADB_PORT=3306      # host port for MariaDB (local dev and integration tests)
# SEED_ON_START=true     # seed 10,000 employees when the database is empty
# SEED_COUNT=10000
